<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="connectionScene" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.am43.client.view.gui.scenes.InLobbyScene">
   <children>
      <VBox alignment="CENTER" fillWidth="false" prefHeight="459.0" prefWidth="842.0" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="welcome to your lobby">
               <styleClass>
                  <String fx:value="lobby-title" />
                  <String fx:value="subtitle" />
               </styleClass>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin></Label>
            <HBox fx:id="playerContainer" alignment="CENTER" fillHeight="false" prefHeight="300.0" prefWidth="200.0" spacing="20.0" />
            <HBox fx:id="banner" alignment="CENTER" fillHeight="false" prefHeight="100.0" styleClass="loginContainer">
               <children>
                  <Label styleClass="loginLabel" text="ENTER A NICKNAME:" />
                  <TextField fx:id="nicknameField" alignment="CENTER" promptText="3-12 alphanumeric" styleClass="loginElement">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </TextField>
                  <Label styleClass="loginLabel" text="CHOOSE A COLOR:" />
                  <HBox alignment="CENTER" fillHeight="false" maxHeight="75.0" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <ToggleButton contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" prefHeight="75.0" prefWidth="50.0" text="Color">
                           <toggleGroup>
                              <ToggleGroup fx:id="colorGroup" />
                           </toggleGroup>
                           <graphic>
                              <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/BLACKtotem.PNG" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <styleClass>
                              <String fx:value="loginElement" />
                              <String fx:value="login-toggle" />
                           </styleClass>
                        </ToggleButton>
                        <ToggleButton contentDisplay="GRAPHIC_ONLY" layoutX="148.0" layoutY="10.0" mnemonicParsing="false" prefHeight="75.0" prefWidth="75.0" text="Color" toggleGroup="$colorGroup">
                           <graphic>
                              <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/WHITEtotem.PNG" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <styleClass>
                              <String fx:value="loginElement" />
                              <String fx:value="login-toggle" />
                           </styleClass>
                        </ToggleButton>
                        <ToggleButton contentDisplay="GRAPHIC_ONLY" layoutX="205.0" layoutY="10.0" mnemonicParsing="false" prefHeight="75.0" prefWidth="75.0" text="Color" toggleGroup="$colorGroup">
                           <graphic>
                              <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/REDtotem.PNG" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <styleClass>
                              <String fx:value="login-toggle" />
                              <String fx:value="loginElement" />
                           </styleClass>
                        </ToggleButton>
                        <ToggleButton contentDisplay="GRAPHIC_ONLY" layoutX="261.0" layoutY="10.0" mnemonicParsing="false" prefHeight="75.0" prefWidth="75.0" text="Color" toggleGroup="$colorGroup">
                           <graphic>
                              <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/YELLOWtotem.PNG" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <styleClass>
                              <String fx:value="loginElement" />
                              <String fx:value="login-toggle" />
                           </styleClass>
                        </ToggleButton>
                        <ToggleButton contentDisplay="GRAPHIC_ONLY" layoutX="348.0" layoutY="10.0" mnemonicParsing="false" prefHeight="75.0" prefWidth="75.0" text="Color" toggleGroup="$colorGroup">
                           <graphic>
                              <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/CYANtotem.PNG" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <styleClass>
                              <String fx:value="login-toggle" />
                              <String fx:value="loginElement" />
                           </styleClass>
                        </ToggleButton>
                     </children>
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </HBox>
                  <Button fx:id="confirmButton" mnemonicParsing="false" onAction="#onConfirmClicked" text="CONFIRM">
                     <styleClass>
                        <String fx:value="loginElement" />
                        <String fx:value="main-button" />
                     </styleClass>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <Label fx:id="lobbyId" alignment="CENTER" styleClass="loginLabel" text="Lobby ID: " AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0" />
       <Button fx:id="settingsButton" contentDisplay="GRAPHIC_ONLY" minHeight="40.0" minWidth="40.0" mnemonicParsing="false" onAction="#onSettingsClicked" pickOnBounds="false" prefHeight="40.0" prefWidth="40.0" styleClass="settings-button" text="aaa" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
           <graphic>
               <Region mouseTransparent="true" prefHeight="200.0" prefWidth="200.0" styleClass="icon" />
           </graphic></Button>
   </children>
</AnchorPane>
